<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sales" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="month" class="java.lang.String"/>
    <parameter name="category" class="java.lang.String"/>
    <parameter name="totalLabel" class="java.lang.String"/>
    <field name="categoryCode" class="java.lang.String"/>
    <field name="sku" class="java.lang.String"/>
    <field name="productName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="revenueLabel" class="java.lang.String"/>
    <title>
        <band height="62">
            <staticText>
                <reportElement x="0" y="0" width="400" height="22"/>
                <textElement><font fontName="SansSerif" size="16" isBold="true"/></textElement>
                <text><![CDATA[Apex Build sales]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="555" height="16"/>
                <textElement><font fontName="SansSerif" size="10"/></textElement>
                <textFieldExpression><![CDATA["Month " + $P{month} + "    Category " + $P{category}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="44" width="555" height="16"/>
                <textElement><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total " + $P{totalLabel}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement x="0" y="0" width="90" height="16"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Category]]></text>
            </staticText>
            <staticText>
                <reportElement x="90" y="0" width="120" height="16"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[SKU]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="0" width="195" height="16"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Product]]></text>
            </staticText>
            <staticText>
                <reportElement x="405" y="0" width="50" height="16"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Units]]></text>
            </staticText>
            <staticText>
                <reportElement x="455" y="0" width="100" height="16"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Revenue]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="90" height="14"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{categoryCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="90" y="0" width="120" height="14"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{sku}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="210" y="0" width="195" height="14"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="405" y="0" width="50" height="14"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="0" width="100" height="14"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{revenueLabel}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
