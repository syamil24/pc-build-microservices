# Copy to .env. Never commit .env.
# scripts/run-all.sh generates JWT_SECRET, INTERNAL_SERVICE_TOKEN,
# and demo passwords when they are empty. It will not invent DB_PASSWORD.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

APEX_DEMO_SEED=true
DEMO_ADMIN_EMAIL=admin@apexbuild.local
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=customer@apexbuild.local
DEMO_CUSTOMER_PASSWORD=

# demo skips the network and uses the in-app checkout.
# live calls https://gate.chip-in.asia and requires the three CHIP values.
CHIP_MODE=demo
CHIP_API_BASE=https://gate.chip-in.asia/api/v1
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
CHIP_PUBLIC_KEY=
# Callback URLs must be public https on port 443 with no explicit port.
CHIP_SUCCESS_CALLBACK=
CHIP_SUCCESS_REDIRECT=http://localhost:5173/orders
CHIP_FAILURE_REDIRECT=http://localhost:5173/checkout

WEBAPP_ORIGIN=http://localhost:5173
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
ZIPKIN_ENABLED=false
SHIPPING_TICK_MS=15000
PAYMENT_INSTANCES=3
DB_POOL_SIZE=3
TOMCAT_MAX_THREADS=20
