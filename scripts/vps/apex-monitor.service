[Unit]
Description=Apex Build VPS monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=github-runner
WorkingDirectory=/opt/actions-runner/_work/pc-build-microservices/pc-build-microservices
ExecStart=/bin/bash /opt/actions-runner/_work/pc-build-microservices/pc-build-microservices/scripts/vps/monitor.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
